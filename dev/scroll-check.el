;;; scroll-check.el --- scroll a live session every way; report layout breaks -*- lexical-binding: t -*-

;; Runs a real (haiku) session, scrolls it in evil normal state (j/k, C-d,
;; C-u, C-f, C-b, C-e, C-y, G, gg, zt/zb/zz, H/M/L, }, the wheel), streams
;; while reading and while typing, splits the window, and after each step
;; records a gap under the input or blank space where the log should be.
;; Needs your init (evil). GUI:  open -n -a Emacs --args -l dev/scroll-check.el
;; Terminal: emacs -nw -l dev/scroll-check.el
;; The report lands in $CN_REPORT_DIR (default: the temp dir) as scroll-report.
(setq claude-native-model "haiku")
(defvar S (file-name-as-directory (or (getenv "CN_REPORT_DIR") temporary-file-directory)))
(defvar R nil)
(defvar BAD 0)
(defvar STEP 0)
(defun pw (secs) (let ((end (+ (float-time) secs))) (while (< (float-time) end) (accept-process-output nil 0.03) (redisplay t))))
(defun spacer-shown ()
  "Pixels of the spacer line on screen, or nil if not shown."
  (let ((a (pos-visible-in-window-p (marker-position claude-native--spacer) nil t))
        (b (pos-visible-in-window-p (1+ claude-native--spacer) nil t)))
    (cond ((and a b) (- (nth 1 b) (nth 1 a)))
          (a (- (window-body-height nil t) (nth 1 a)))
          (b (nth 1 b)))))
(defun check (name)
  (pw 0.25)
  (cl-incf STEP)
  (let* ((v (pos-visible-in-window-p (point-max) nil t))
         (gap (and v (- (window-body-height nil t)
                        (+ (nth 1 v) (save-excursion (goto-char (point-max)) (line-pixel-height))))))
         (sp (spacer-shown))
         (row (default-line-height))
         ;; The log is longer than the window, so the spacer should be
         ;; one row (the status row); anything much taller is blank space.
         (bad (or (and gap (/= gap 0)) (and sp (> sp (* 3 row))))))
    (push (format "%2d %-14s %s pt=%s start=%s gap=%s spacer=%s sp@%s in@%s char=%S" STEP name (if bad "BAD" "ok ") (point) (window-start) gap sp (marker-position claude-native--spacer) (marker-position claude-native--input) (char-after)) R)

    (when bad (cl-incf BAD))))
(defun keys (s) (condition-case nil (execute-kbd-macro (kbd s)) (error nil)))
(defun wheel (dir n)
  (dotimes (_ n)
    (mwheel-scroll (list (if (eq dir 'down) 'wheel-down 'wheel-up) (posn-at-point (window-start))))
    (pw 0.02)))
(let ((default-directory (make-temp-file "cn-scroll" t)))
  (claude-native)
  (let ((end (+ (float-time) 15))) (while (and (null claude-native--commands) (< (float-time) end)) (accept-process-output nil 0.1)))
  (goto-char (point-max)) (insert "Print the numbers 1 to 90, one per line, nothing else.")
  (claude-native-send)
  (let ((end (+ (float-time) 60))) (pw 2) (while (and claude-native--busy (< (float-time) end)) (accept-process-output nil 0.05) (redisplay t)))
  (pw 1)
  (condition-case err
      (progn
        (check "start")
        (keys "<escape>") (check "esc")
        (dotimes (_ 45) (keys "k")) (check "45k")
        (dotimes (i 50) (keys "j") (check (format "j%d" (1+ i))))
        (keys "C-u") (check "C-u") (keys "C-d") (check "C-d") (keys "C-d") (check "C-d2")
        (keys "C-e C-e C-e") (check "C-e x3")
        (keys "C-u") (keys "C-e C-e C-e C-e C-e C-e C-e C-e C-e C-e C-e C-e C-e C-e C-e C-e C-e C-e C-e C-e") (check "C-u C-e x20")
        (keys "G") (check "G") (keys "g g") (check "gg") (keys "G") (check "G2")
        (keys "C-b") (check "C-b") (keys "C-f") (check "C-f") (keys "C-f") (check "C-f2")
        (keys "C-u") (keys "z t") (check "zt") (keys "z b") (check "zb") (keys "z z") (check "zz")
        (keys "C-u") (keys "L") (check "L") (keys "j j j") (check "L jjj")
        (keys "C-u") (keys "}") (check "}") (keys "} } } } }") (check "} x6")
        (ignore-errors (wheel (quote up) 10)) (check "wheel up") (ignore-errors (wheel (quote down) 30)) (check "wheel down")
        (keys "C-u") (keys "C-y") (check "C-y") (keys "C-e") (check "C-e")
        (keys "i") (check "insert") (insert "hi") (check "typed")
        ;; Streaming while reading up: the window must hold still.
        (claude-native--set-input "Print the numbers 1 to 60, one per line, nothing else.")
        (goto-char (point-max)) (claude-native-send) (pw 0.3)
        (keys "<escape>") (dotimes (_ 12) (keys "k")) (pw 0.2)
        (let ((s0 (window-start)) (moved 0) (n 0) (end (+ (float-time) 60)))
          (while (and claude-native--busy (< (float-time) end))
            (pw 0.3) (cl-incf n) (unless (= (window-start) s0) (cl-incf moved))
            (check "stream-read"))
          (push (format "reading while streaming: window moved %d of %d checks" moved n) R))
        (keys "G") (check "G after")
        ;; Streaming with the cursor in the input: pinned to the bottom.
        (keys "i") (claude-native--set-input "Print the numbers 1 to 60, one per line, nothing else.")
        (goto-char (point-max)) (claude-native-send)
        (let ((end (+ (float-time) 60))) (pw 0.3)
          (while (and claude-native--busy (< (float-time) end)) (check "stream-input")))
        (check "stream-done")
        (let ((n 0)) (advice-add 'claude-native--set-spacer :before (lambda (&rest _) (cl-incf n)) '((name . count)))
          (pw 2) (push (format "idle 2s, one window: %d spacer sets" n) R)
          (setq n 0) (split-window-below) (pw 0.5) (setq n 0) (pw 2)
          (push (format "idle 2s, split: %d spacer sets" n) R)
          (check "split-sel") (keys "<escape>") (dotimes (_ 10) (keys "k")) (check "split-k") (keys "G") (check "split-G")
          (other-window 1) (check "split-other") (keys "G") (check "split-other-G")
          (delete-other-windows) (pw 0.3) (check "unsplit")
          (advice-remove 'claude-native--set-spacer 'count))
        (push (format "measure (cache miss): %S" (benchmark-run 20 (progn (set-window-parameter nil 'claude-native-bottom nil) (claude-native--bottom (selected-window))))) R)
        (push (format "keystroke+redisplay: %S" (benchmark-run 30 (execute-kbd-macro "a") (redisplay t))) R))
    (error (push (format "ERROR %S" err) R)))
  (push (format "BAD steps: %d of %d" BAD STEP) R)
  (write-region (string-join (nreverse R) "\n") nil (concat S "scroll-report"))
  (kill-emacs))
